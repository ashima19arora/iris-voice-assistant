# ==============================================================================
# IRIS ASSISTANT — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Focus: BUILD IT Track (100% Free, On Your Machine, Zero Cloud Bill)
# ==============================================================================

# 1. AI Reasoning & Q&A (OpenRouter Free Tier Models)
# Generate your free key in 30 seconds at: https://openrouter.ai/keys
OPENROUTER_API_KEYS=your_openrouter_api_key_here
OPENROUTER_PRIMARY_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_SEC=4.5

# 2. Security Audit Ledger Configuration (AWS Cedar & DynamoDB)
# Works 100% offline with LocalStack (localhost:4566) or cloud DynamoDB.
DYNAMODB_TABLE_NAME=IrisSecurityAuditTesting
AWS_DEFAULT_REGION=eu-north-1